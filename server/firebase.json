{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/status",
        "function": "status"
      },
      {
        "source": "/take",
        "function": "take"
      },
      {
        "source": "/next",
        "function": "next_call"
      },
      {
        "source": "/miss",
        "function": "mark_missed"
      },
      {
        "source": "/reset",
        "function": "manual_reset"
      },
      {
        "source": "/previous",
        "function": "go_previous"
      },
      {
        "source": "/control",
        "destination": "/control.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "python313"
    }
  ]
}
